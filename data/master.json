  "policies": {
    "privacy": {
      "intro": {
        "en": "We respect your privacy and are committed to protecting personal data collected through our system.",
        "bn": "আমরা আপনার গোপনীয়তাকে সম্মান করি এবং আমাদের সিস্টেমের মাধ্যমে সংগৃহীত ব্যক্তিগত ডেটা রক্ষা করতে প্রতিশ্রুতিবদ্ধ।",
        "ar": "نحن نحترم خصوصيتك ونلتزم بحماية البيانات الشخصية التي يتم جمعها من خلال نظامنا."
      },
      "dataCollectedTitle": {
        "en": "Data We Collect",
        "bn": "আমরা যে ডেটা সংগ্রহ করি",
        "ar": "البيانات التي نجمعها"
      },
      "dataCollected": {
        "en": "We collect information necessary to provide educational services: names, contact details, role, class assignments, attendance, progress and fee records.",
        "bn": "শিক্ষামূলক সেবা প্রদানের জন্য প্রয়োজনীয় তথ্য সংগ্রহ করা হয়: নাম, যোগাযোগের বিবরণ, ভূমিকা, ক্লাস বরাদ্দ, উপস্থিতি, অগ্রগতি এবং ফি রেকর্ড।",
        "ar": "نقوم بجمع المعلومات اللازمة لتقديم الخدمات التعليمية: الأسماء وتفاصيل الاتصال والدور وتعيينات الفصول والحضور والتقدم وسجلات الرسوم."
      },
      "howUseTitle": {
        "en": "How We Use Data",
        "bn": "কিভাবে আমরা ডেটা ব্যবহার করি",
        "ar": "كيفية استخدامنا للبيانات"
      },
      "howUse": {
        "en": "Data is used to manage enrollment, attendance, progress tracking, communications, and billing. We do not sell personal data.",
        "bn": "ডেটা ভর্তি, উপস্থিতি, অগ্রগতি ট্র্যাকিং, যোগাযোগ এবং বিলিং পরিচালনার জন্য ব্যবহার করা হয়। আমরা ব্যক্তিগত ডেটা বিক্রি করি না।",
        "ar": "تُستخدم البيانات لإدارة التسجيل والحضور وتتبع التقدم والاتصالات والفوترة. نحن لا نبيع البيانات الشخصية."
      },
      "securityTitle": {
        "en": "Security",
        "bn": "নিরাপত্তা",
        "ar": "الأمن"
      },
      "security": {
        "en": "We use industry-standard measures to protect data. Passwords are hashed and sensitive operations occur server-side. Access is role-based.",
        "bn": "ডেটা সুরক্ষার জন্য শিল্প-মানের ব্যবস্থা ব্যবহার করা হয়। পাসওয়ার্ড হ্যাশ করা হয় এবং সংবেদনশীল অপারেশন সার্ভার-সাইডে ঘটে। অ্যাক্সেস রোল-ভিত্তিক।",
        "ar": "نستخدم تدابير معيارية لحماية البيانات. يتم تجزئة كلمات المرور وتتم العمليات الحساسة على الخادم. الوصول قائم على الأدوار."
      },
      "contactTitle": {
        "en": "Contact",
        "bn": "যোগাযোগ",
        "ar": "اتصل"
      }
    },
    "terms": {
      "intro": {
        "en": "These Terms govern your use of the Madrasha Management System and related services.",
        "bn": "এই শর্তাবলী মাদ্রাসা ম্যানেজমেন্ট সিস্টেম এবং সম্পর্কিত পরিষেবাগুলির আপনার ব্যবহারের শর্ত নির্ধারণ করে।",
        "ar": "تحكم هذه الشروط استخدامك لنظام إدارة المدرسة والخدمات ذات الصلة."
      },
      "acceptTitle": {
        "en": "Acceptance",
        "bn": "গ্রহণ",
        "ar": "القبول"
      },
      "acceptText": {
